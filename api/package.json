{
  "name": "@salary/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express 5 API for salary management. Node runs this TypeScript directly (type stripping).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@salary/shared": "0.0.0",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1"
  }
}
