{
  "name": "salary-management",
  "private": true,
  "type": "module",
  "description": "Salary management for ACME's HR manager: employee records, salary history and pay insights.",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "workspaces": [
    "shared"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
